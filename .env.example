# Copy to .env (never commit .env). Every variable the apps read is listed here.

# --- shared ---
NODE_ENV=development
# Public origin of the site, no trailing slash. Used for links, cookies and OAuth redirects.
PUBLIC_URL=http://localhost:3000
# Display name of the product. Change it here to rename the site.
BRAND_NAME=Podium
NEXT_PUBLIC_BRAND_NAME=Podium

# --- api ---
PORT=4000
# Address the API listens on. Keep it on localhost behind Nginx (the API trusts X-Forwarded-For).
HOST=127.0.0.1
DATABASE_URL=postgresql://podium:podium@127.0.0.1:5432/podium
REDIS_URL=redis://127.0.0.1:6379
# 32+ random bytes, e.g. `openssl rand -hex 32`. Signs session cookies and CSRF tokens.
SESSION_SECRET=
# Google sign-in. Redirect URI to register: <PUBLIC_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# SMTP for one-time sign-in codes, e.g. smtps://user:pass@smtp.example.com:465
EMAIL_SMTP_URL=
EMAIL_FROM=Podium <no-reply@example.com>
# Set to 0 to accept finishes without a live input stream (local development only).
REQUIRE_STREAM=1
# Multiplies every rate limit (1 = the built-in limits). Raise it only for load tests.
RATE_LIMIT_SCALE=1

# --- web ---
# Where the Next.js server reaches the API for server-side rendering.
API_INTERNAL_URL=http://127.0.0.1:4000
