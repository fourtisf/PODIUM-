# Copy to .env (never commit .env). Every variable the apps read is listed here.

# --- shared ---
NODE_ENV=development
# Public origin of the site, no trailing slash. Used for links, cookies and OAuth redirects.
PUBLIC_URL=http://localhost:3000
# Display name of the product. Change it here to rename the site.
BRAND_NAME="Climb Games"
NEXT_PUBLIC_BRAND_NAME="Climb Games"
# The project's X profile. Empty: https://x.com/PlayClimbGames. "none" hides the X links.
NEXT_PUBLIC_X_URL=
# Token contract address (Solana) shown in the bar under the header with a copy button.
# Empty: the bar shows "Coming soon". Do not put a mainnet token address here before the owner
# has the written legal opinion (CLAUDE.md rule 1); the site copy says tChips have no value.
# Both are build-time values: rebuild the web app after changing them.
NEXT_PUBLIC_TOKEN_CA=
# Contact address shown on /terms and /privacy (account deletion and data requests go here).
# Empty: the pages show "[contact email]". The NEXT_PUBLIC_ one is read at build time: rebuild the web app after changing it.
CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_EMAIL=

# --- api ---
PORT=4000
# Port of the Next.js web app (behind Nginx). Change both ports when the server already runs other apps.
WEB_PORT=3000
# Prefix of the two PM2 process names (<prefix>-web, <prefix>-api).
PM2_PREFIX=climbgames
# Address the API listens on. Keep it on localhost behind Nginx (the API trusts X-Forwarded-For).
HOST=127.0.0.1
DATABASE_URL=postgresql://podium:podium@127.0.0.1:5432/podium
REDIS_URL=redis://127.0.0.1:6379
# 32+ random bytes, e.g. `openssl rand -hex 32`. Signs session cookies and CSRF tokens.
SESSION_SECRET=
# Google sign-in. Redirect URI to register: <PUBLIC_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# SMTP for one-time sign-in codes, e.g. smtps://user:pass@smtp.example.com:465
EMAIL_SMTP_URL=
EMAIL_FROM="Climb Games <no-reply@example.com>"
# Set to 0 to accept finishes without a live input stream (local development only).
REQUIRE_STREAM=1
# Multiplies every rate limit (1 = the built-in limits). Raise it only for load tests.
RATE_LIMIT_SCALE=1
# Operators who may use /admin and /api/admin (comma-separated). An account is an operator when its
# sign-in email (case-insensitive) or its linked Solana wallet address is listed. There is no other way in.
ADMIN_EMAILS=
ADMIN_WALLETS=

# --- web ---
# Where the Next.js server reaches the API for server-side rendering.
API_INTERNAL_URL=http://127.0.0.1:4000
# Also read by `next build`: the /api rewrite that lets `next dev` / `next start` run without Nginx is fixed at build time.
# WebSocket origin for the live run stream (rewrites do not proxy WebSockets), e.g. wss://example.com.
# Leave empty in production behind Nginx (same origin is used); `next dev` falls back to ws://<host>:4000.
# A local `next start` without Nginx needs it set at build time, e.g. ws://127.0.0.1:4000.
NEXT_PUBLIC_WS_URL=

# --- Phase 3: Solana DEVNET / local validator, TEST token with no value (see deploy/phase3-devnet.md) ---
# off (default): tChips stay plain test chips and nothing below is read.
# localnet: a solana-test-validator on this machine. devnet: the public devnet.
# Any other value stops the API at boot; mainnet cannot be configured.
CHAIN_MODE=off
# Optional RPC override (a devnet RPC provider). Empty = the cluster's public endpoint. A mainnet URL or node is refused.
SOLANA_RPC_URL=
# From packages/chain/scripts/setup-devnet.ts (it prints PODIUM_PROGRAM_ID and PODIUM_MINT).
PODIUM_PROGRAM_ID=
PODIUM_MINT=
# The game server's operator key: a path to a JSON keypair file (preferred), or the JSON array itself.
# It must be the operator given to setup-devnet.ts, and it needs a little devnet SOL for fees. Never commit it.
CHAIN_OPERATOR_KEYPAIR=
# Optional. The TEST mint's authority (the admin key used by setup-devnet.ts). Setting it switches on the
# "Get test tokens" faucet, which mints the valueless test token to a player's wallet. Never commit it.
CHAIN_FAUCET_KEYPAIR=
# Whole tChips per faucet request (one request per account per 24 hours).
CHAIN_FAUCET_AMOUNT=5000
# Country blocking of value features (deposit, withdraw, faucet, ranked / Cup / duel entries, shop, reward claims).
# Comma-separated ISO codes. If ALLOWED_COUNTRIES is set only those may use them, and a request without a
# country is refused; otherwise BLOCKED_COUNTRIES are refused. Practice and the boards stay open everywhere.
BLOCKED_COUNTRIES=
ALLOWED_COUNTRIES=
# Request header that carries the visitor's country. Cloudflare sets cf-ipcountry; with Nginx GeoIP set it
# yourself and make sure a header sent by the visitor is overwritten. The web app reads this name too.
GEO_HEADER=cf-ipcountry
# Web (fixed at build time: rebuild the web app after changing them). Must match the API's values.
NEXT_PUBLIC_CHAIN_MODE=off
NEXT_PUBLIC_PODIUM_PROGRAM_ID=
NEXT_PUBLIC_PODIUM_MINT=
# RPC the browser uses to send deposits. Empty = the cluster's public endpoint.
NEXT_PUBLIC_SOLANA_RPC_URL=
