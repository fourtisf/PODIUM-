{
  "name": "podium",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "dev:api": "pnpm --filter @podium/api dev",
    "dev:web": "pnpm --filter @podium/web dev",
    "covers": "node scripts/export-covers.mjs",
    "prisma": "pnpm --filter @podium/api exec prisma"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
